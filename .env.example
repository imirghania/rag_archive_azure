# Copy to .env and edit. Every value here is read by docai.core.settings.Settings.
# Variables use the prefix DOCAI_. Nested names use a double underscore.

# local = run everything on this machine with fakes; azure = use the real services
DOCAI_ADAPTERS=local
DOCAI_ENV=dev

# --- Region and naming (used by the deployment scripts and the Azure adapters) ---
DOCAI_LOCATION=swedencentral
DOCAI_LOCATION_FALLBACK=eastus2
DOCAI_PREFIX=docai
DOCAI_RESOURCE_GROUP=rg-docai-dev

# --- Model deployments: one name per role (see spec, Region and model deployments) ---
# gpt-5 has quota 0 on this subscription, so every role uses gpt-5-mini for now.
DOCAI_MODELS__ANSWER_AGENT=gpt-5-mini
DOCAI_MODELS__ROUTER=gpt-5-mini
DOCAI_MODELS__SEGMENTATION=gpt-5-mini
DOCAI_MODELS__METADATA=gpt-5-mini
DOCAI_MODELS__SECOND_READER=gpt-5-mini
DOCAI_MODELS__VERIFIER=gpt-5-mini
DOCAI_MODELS__EMBEDDINGS=text-embedding-3-large

# --- Azure endpoints: filled in by deploy/s90_write_env.py after deployment ---
DOCAI_AZURE__SUBSCRIPTION_ID=
DOCAI_AZURE__TENANT_ID=
DOCAI_AZURE__SERVICEBUS_NAMESPACE=
DOCAI_AZURE__STORAGE_RAW_ACCOUNT=
DOCAI_AZURE__STORAGE_PROC_ACCOUNT=
DOCAI_AZURE__STORAGE_STAGING_ACCOUNT=
DOCAI_AZURE__SEARCH_ENDPOINT=
DOCAI_AZURE__FOUNDRY_ENDPOINT=
DOCAI_AZURE__FOUNDRY_PROJECT_ENDPOINT=
DOCAI_AZURE__OCR_ENDPOINT=
DOCAI_AZURE__CONTENT_SAFETY_ENDPOINT=
DOCAI_AZURE__KEY_VAULT_URI=
DOCAI_AZURE__APPINSIGHTS_CONNECTION_STRING=

# --- Operational database (PostgreSQL 16) ---
# Locally leave DOCAI_DATABASE__URL unset: `localdev` starts a Docker container `docai-pg-dev` on port 55432 (this is the default URL).
# Set it to use your own PostgreSQL (a superuser, because the migrations create roles).
# DOCAI_DATABASE__URL=postgresql+psycopg://docai:docai@localhost:55432/docai
# Azure Database for PostgreSQL with Entra login: the managed identity's name is the user, the password is an Entra token.
DOCAI_DATABASE__HOST=
DOCAI_DATABASE__NAME=docai
DOCAI_DATABASE__USER=
DOCAI_DATABASE__ENTRA_AUTH=false

# --- Entra (Free tier) ---
DOCAI_AUTH__TENANT_ID=
DOCAI_AUTH__API_CLIENT_ID=
DOCAI_AUTH__WEB_CLIENT_ID=
# The web client secret lives in Key Vault in Azure; set it here only for local sign-in tests.
DOCAI_AUTH__WEB_CLIENT_SECRET=

# --- Local fakes ---
DOCAI_LOCAL_DIR=.local
