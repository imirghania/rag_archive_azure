            "fieldName": "subject"
          },
          "prioritizedContentFields": [
            {
              "fieldName": "text_en"
            },
            {
              "fieldName": "text_ar"
            }
          ],
          "prioritizedKeywordsFields": [
            {
              "fieldName": "doc_type"
            },
            {
              "fieldName": "reference"
            }
          ]
        }
      }
    ]
  },
  "vectorSearch": {
    "algorithms": [
      {
        "name": "hnsw-cosine",
        "kind": "hnsw",
        "hnswParameters": {
          "metric": "cosine",
          "m": 4,
          "efConstruction": 400,
          "efSearch": 500
        }
      }
    ],
    "compressions": [
      {
        "name": "sq8",
        "kind": "scalarQuantization",
        "scalarQuantizationParameters": {
          "quantizedDataType": "int8"
        },
        "rerankWithOriginalVectors": true,
        "defaultOversampling": 4
      }
    ],
    "profiles": [
      {
        "name": "vec-profile",
        "algorithm": "hnsw-cosine",
        "compression": "sq8"
      }
    ]
